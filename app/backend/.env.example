# Port the Express server listens on
PORT=4000

# Comma-separated list of admin emails allowed to use the protected endpoints
# (mirrors the isAdmin() allowlist in firestore.rules)
ADMIN_EMAILS=vihakids5@gmail.com

# Origin(s) allowed to call this API from the browser (comma-separated)
CORS_ORIGIN=http://localhost:5173

# --- Firebase Admin credentials: use ONE of the two options below ---

# Option A (recommended for local dev): path to the downloaded service-account
# JSON file (see app/README.md for how to get this file). Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B (useful once you pick a hosting provider): base64-encode the same
# JSON file's contents and paste the result here instead of using a file.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Anthropic API key for the website's chat widget (POST /api/chat).
# Get one at https://console.anthropic.com/ — never commit the real value.
# Without this set, the chat widget shows a "message us on WhatsApp" fallback.
ANTHROPIC_API_KEY=
